{
  "schemaVersion": 1,
  "id": "react",
  "name": "React",
  "category": "frontend",
  "description": "A React single-page application powered by the official Vite starter.",
  "docsUrl": "https://react.dev/learn",
  "tags": [
    "react",
    "spa",
    "vite"
  ],
  "icon": "react",
  "verifiedAt": "2026-07-28",
  "setup": {
    "nodeTooling": true
  },
  "requires": {
    "node": ">=20.19.0",
    "packageManagers": [
      "pnpm",
      "npm",
      "yarn",
      "bun"
    ],
    "tools": []
  },
  "fields": [
    {
      "id": "typescript",
      "label": "TypeScript",
      "type": "boolean",
      "default": true,
      "help": "Generate typed .tsx source files and a TypeScript configuration."
    },
    {
      "id": "linting",
      "label": "Linting",
      "type": "select",
      "default": "eslint",
      "help": "Configure a linter and package scripts for the generated project.",
      "options": [
        {
          "value": "eslint",
          "label": "ESLint"
        },
        {
          "value": "oxlint",
          "label": "Oxlint"
        },
        {
          "value": "biome",
          "label": "Biome"
        }
      ]
    },
    {
      "id": "formatting",
      "label": "Formatting",
      "type": "select",
      "default": "prettier",
      "help": "Configure a formatter and format/format:check package scripts.",
      "options": [
        {
          "value": "prettier",
          "label": "Prettier"
        },
        {
          "value": "oxfmt",
          "label": "Oxfmt"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold React project",
      "bin": "npx",
      "cwd": "parentDir",
      "env": {
        "CI": "1"
      },
      "args": [
        "--yes",
        "create-vite@latest",
        "${projectName}",
        "--template",
        {
          "if": "typescript",
          "then": [
            "react-ts"
          ],
          "else": [
            "react"
          ]
        },
        "--no-interactive"
      ]
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "${packageManager}",
      "cwd": "projectDir",
      "env": {
        "CI": "1"
      },
      "args": [
        "install"
      ],
      "when": "installDeps"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "git",
      "cwd": "projectDir",
      "env": {
        "CI": "1"
      },
      "args": [
        "init"
      ],
      "when": "gitInit"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "git",
      "cwd": "projectDir",
      "env": {
        "CI": "1"
      },
      "args": [
        "add",
        "--all"
      ],
      "when": "gitInit"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "git",
      "cwd": "projectDir",
      "env": {
        "CI": "1"
      },
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "when": "gitInit"
    }
  ]
}
