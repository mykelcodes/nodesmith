{
  "recipeId": "expo",
  "projectDir": "expo-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Expo project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-expo-app@latest",
        "expo-app",
        "--template",
        "default",
        "--yes",
        "--no-install",
        "--no-agents-md"
      ],
      "dir": ".",
      "env": {
        "CI": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "display": "/tools/npx --yes create-expo-app@latest expo-app --template default --yes --no-install --no-agents-md"
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "expo-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "expo-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "expo-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "expo-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "c680077ea317a1b4356386e788dd95f9478fc1c9368b9aca04b9b619683d8460"
}
