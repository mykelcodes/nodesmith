{
  "recipeId": "hono",
  "projectDir": "hono-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Hono project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-hono@latest",
        "hono-app",
        "--template",
        "nodejs",
        "--pm",
        "pnpm",
        "--install"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes create-hono@latest hono-app --template nodejs --pm pnpm --install"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [],
  "hash": "ee9097c5627bcf99e9632a312d7e27b9bd22b0f5a86b580056070f66ac4259fd"
}
