{
  "recipeId": "hono",
  "projectDir": "hono-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Hono project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-hono@latest",
        "hono-app",
        "--template",
        "nodejs",
        "--pm",
        "pnpm",
        "--install"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes create-hono@latest hono-app --template nodejs --pm pnpm --install"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "hono-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "hono",
        "template": "nodejs",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install-tooling",
      "label": "Install configured tooling",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "hono-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
