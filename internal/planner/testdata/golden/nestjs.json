{
  "recipeId": "nestjs",
  "projectDir": "nestjs-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold NestJS project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "@nestjs/cli@latest",
        "new",
        "nestjs-app",
        "--package-manager",
        "pnpm",
        "--language",
        "typescript",
        "--skip-install",
        "--skip-git",
        "--strict"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes @nestjs/cli@latest new nestjs-app --package-manager pnpm --language typescript --skip-install --skip-git --strict"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "nestjs-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "nestjs",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "c98bafd87d3cfce7155c21576f924bd82ee9f053b8c6e396f5b3c7476e296cda"
}
