{
  "recipeId": "nestjs",
  "projectDir": "nestjs-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold NestJS project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "@nestjs/cli@latest",
        "new",
        "nestjs-app",
        "--package-manager",
        "pnpm",
        "--language",
        "typescript",
        "--skip-install",
        "--skip-git",
        "--strict"
      ],
      "dir": ".",
      "env": {
        "CI": "1"
      },
      "display": "/tools/npx --yes @nestjs/cli@latest new nestjs-app --package-manager pnpm --language typescript --skip-install --skip-git --strict"
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "nestjs-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "5b9580ddfcab1a063a1f1902f30ec5b6a1fd0c444f087c0222c3a452d5fd408f"
}
