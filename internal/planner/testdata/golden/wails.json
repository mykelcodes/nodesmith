{
  "recipeId": "wails",
  "projectDir": "wails-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Wails v2 project",
      "bin": "/tools/wails",
      "args": [
        "init",
        "-n",
        "wails-app",
        "-d",
        "wails-app",
        "-t",
        "svelte-ts",
        "-nocolour",
        "-g"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/wails init -n wails-app -d wails-app -t svelte-ts -nocolour -g"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "wails-app/frontend",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "wails",
        "template": "svelte-ts",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install",
      "label": "Install frontend dependencies",
      "bin": "/tools/npm",
      "args": [
        "--prefix",
        "frontend",
        "install",
        "--save-dev",
        "@sveltejs/vite-plugin-svelte@latest"
      ],
      "dir": "wails-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npm --prefix frontend install --save-dev @sveltejs/vite-plugin-svelte@latest"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "wails-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "wails-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [],
  "hash": "8899692c2e14b565234daafc68376ca869e9f2c3b5b88d323b4bc470333f9246"
}
