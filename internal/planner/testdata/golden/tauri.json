{
  "recipeId": "tauri",
  "projectDir": "tauri-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Tauri project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-tauri-app@latest",
        "tauri-app",
        "--manager",
        "pnpm",
        "--template",
        "svelte-ts",
        "--identifier",
        "com.example.app",
        "--tauri-version",
        "2",
        "--yes"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes create-tauri-app@latest tauri-app --manager pnpm --template svelte-ts --identifier com.example.app --tauri-version 2 --yes"
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "tauri-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "tauri-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "tauri-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "tauri-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "d54557df946065391466863bbb12d4a2c2eb9f9c33548a0d4a7a4e7d5fc93683"
}
