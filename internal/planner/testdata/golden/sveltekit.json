{
  "recipeId": "sveltekit",
  "projectDir": "sveltekit-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold SvelteKit project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "sv@latest",
        "create",
        "sveltekit-app",
        "--template",
        "minimal",
        "--types",
        "ts",
        "--no-add-ons",
        "--no-install",
        "--no-download-check"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes sv@latest create sveltekit-app --template minimal --types ts --no-add-ons --no-install --no-download-check"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "sveltekit-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "sveltekit",
        "template": "minimal",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "sveltekit-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "sveltekit-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "sveltekit-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "sveltekit-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "7a8a6988c8d2cd0b86c8218076e271dbf00d01793fbee523b94f775d8000204b"
}
