{
  "recipeId": "electron",
  "projectDir": "electron-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Electron project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-electron-app@latest",
        "electron-app",
        "--template",
        "vite-typescript",
        "--skip-git",
        "--electron-version",
        "latest"
      ],
      "dir": ".",
      "env": {
        "CI": "1",
        "NODE_INSTALLER": "pnpm",
        "pnpm_config_block_exotic_subdeps": "false",
        "pnpm_config_dangerously_allow_all_builds": "true",
        "pnpm_config_node_linker": "hoisted"
      },
      "display": "/tools/npx --yes create-electron-app@latest electron-app --template vite-typescript --skip-git --electron-version latest"
    },
    {
      "id": "pnpm-build-policy",
      "label": "Persist pnpm build policy",
      "bin": "/tools/pnpm",
      "args": [
        "config",
        "set",
        "allowBuilds",
        "{\"electron\":true,\"electron-winstaller\":true,\"esbuild\":true}",
        "--json",
        "--location=project"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/pnpm config set allowBuilds '{\"electron\":true,\"electron-winstaller\":true,\"esbuild\":true}' --json --location=project"
    },
    {
      "id": "pnpm-node-linker",
      "label": "Configure pnpm node linker",
      "bin": "/tools/pnpm",
      "args": [
        "config",
        "set",
        "nodeLinker",
        "hoisted",
        "--location=project"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/pnpm config set nodeLinker hoisted --location=project"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [],
  "hash": "764a76cf6a97d919424b7f9946a7aae14add866a1ac7dc6046842c6f70b93b91"
}
