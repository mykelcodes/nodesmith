{
  "recipeId": "electron",
  "projectDir": "electron-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Electron project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-electron-app@latest",
        "electron-app",
        "--template",
        "vite-typescript",
        "--skip-git",
        "--electron-version",
        "latest"
      ],
      "dir": ".",
      "env": {
        "CI": "true",
        "NODE_INSTALLER": "pnpm",
        "pnpm_config_block_exotic_subdeps": "false",
        "pnpm_config_dangerously_allow_all_builds": "true",
        "pnpm_config_node_linker": "hoisted"
      },
      "display": "/tools/npx --yes create-electron-app@latest electron-app --template vite-typescript --skip-git --electron-version latest"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "electron-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "electron",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "pnpm-build-policy",
      "label": "Persist pnpm build policy",
      "bin": "/tools/pnpm",
      "args": [
        "config",
        "set",
        "allowBuilds",
        "{\"electron\":true,\"electron-winstaller\":true,\"esbuild\":true}",
        "--json",
        "--location=project"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm config set allowBuilds '{\"electron\":true,\"electron-winstaller\":true,\"esbuild\":true}' --json --location=project"
    },
    {
      "id": "pnpm-node-linker",
      "label": "Configure pnpm node linker",
      "bin": "/tools/pnpm",
      "args": [
        "config",
        "set",
        "nodeLinker",
        "hoisted",
        "--location=project"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm config set nodeLinker hoisted --location=project"
    },
    {
      "id": "install-tooling",
      "label": "Install configured tooling",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "electron-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "3104580e2ec516abb691ed6ab74dead672df68c4dde2061d22b00f554d10b6b3"
}
