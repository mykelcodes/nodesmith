{
  "recipeId": "astro",
  "projectDir": "astro-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Astro project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-astro@latest",
        "astro-app",
        "--template",
        "minimal",
        "--yes",
        "--no-install",
        "--no-git",
        "--no-ai",
        "--skip-houston"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes create-astro@latest astro-app --template minimal --yes --no-install --no-git --no-ai --skip-houston"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "astro-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "astro",
        "template": "minimal",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "astro-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "astro-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "astro-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "astro-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
