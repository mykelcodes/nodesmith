{
  "recipeId": "vite",
  "projectDir": "vite-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-vite@latest",
        "vite-app",
        "--template",
        "vanilla-ts",
        "--no-interactive",
        "--no-immediate"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes create-vite@latest vite-app --template vanilla-ts --no-interactive --no-immediate"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "vite-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "vite",
        "template": "vanilla-ts",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "vite-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "vite-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "vite-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "vite-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
