{
  "recipeId": "express",
  "projectDir": "express-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Express project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "express-generator@latest",
        "express-app",
        "--view",
        "ejs"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes express-generator@latest express-app --view ejs"
    },
    {
      "id": "configure-project",
      "kind": "project-setup",
      "label": "Configure project tooling",
      "bin": "",
      "args": [],
      "dir": "express-app",
      "env": {},
      "display": "Configure eslint + prettier",
      "setup": {
        "recipeId": "express",
        "linting": "eslint",
        "formatting": "prettier"
      }
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "express-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "express-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "express-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "express-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "0eb49f98bc2de643a0636e411640741ce711fdd490eda8daa45f73cd485777e2"
}
