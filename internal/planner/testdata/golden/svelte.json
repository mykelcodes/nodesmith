{
  "recipeId": "svelte",
  "projectDir": "svelte-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Svelte project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-vite@latest",
        "svelte-app",
        "--template",
        "svelte-ts",
        "--no-interactive"
      ],
      "dir": ".",
      "env": {
        "CI": "1"
      },
      "display": "/tools/npx --yes create-vite@latest svelte-app --template svelte-ts --no-interactive"
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/pnpm install"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "1"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [],
  "hash": "7ff10fcfd35a289c77c15b0cf22bf7032cfd4e27528a354c3df665be8097239e"
}
