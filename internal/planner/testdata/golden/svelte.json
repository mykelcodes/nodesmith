{
  "recipeId": "svelte",
  "projectDir": "svelte-app",
  "steps": [
    {
      "id": "scaffold",
      "label": "Scaffold Svelte project",
      "bin": "/tools/npx",
      "args": [
        "--yes",
        "create-vite@latest",
        "svelte-app",
        "--template",
        "svelte-ts",
        "--no-interactive"
      ],
      "dir": ".",
      "env": {
        "CI": "true"
      },
      "display": "/tools/npx --yes create-vite@latest svelte-app --template svelte-ts --no-interactive"
    },
    {
      "id": "install",
      "label": "Install dependencies",
      "bin": "/tools/pnpm",
      "args": [
        "install",
        "--config.strict-dep-builds=false"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/pnpm install --config.strict-dep-builds=false"
    },
    {
      "id": "git-init",
      "label": "Initialise repository",
      "bin": "/tools/git",
      "args": [
        "init"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git init"
    },
    {
      "id": "git-add",
      "label": "Stage initial files",
      "bin": "/tools/git",
      "args": [
        "add",
        "--all"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git add --all"
    },
    {
      "id": "git-commit",
      "label": "Create initial commit",
      "bin": "/tools/git",
      "args": [
        "commit",
        "-m",
        "Initial commit"
      ],
      "dir": "svelte-app",
      "env": {
        "CI": "true"
      },
      "display": "/tools/git commit -m 'Initial commit'"
    }
  ],
  "warnings": [
    "pnpm will leave unapproved dependency build scripts blocked instead of failing project creation. Review them and run pnpm approve-builds in the generated project if those scripts are required."
  ],
  "hash": "1548e260c4c9e3135fe4321639cff93664e2562f1dc23e69a9c53197687bd142"
}
